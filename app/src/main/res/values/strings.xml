    <string name="do_title">自动卸载设置</string>
    <string name="do_subtitle">设备所有者与静默卸载</string>
    <string name="do_status_label">设备所有者</string>
    <string name="do_ready">已就绪</string>
    <string name="do_not_ready">未配置</string>
    <string name="do_ready_desc">FuckOff 已获得设备管理权限，可以静默卸载黑名单中的应用。</string>
    <string name="do_not_ready_desc">配置后，自动模式才能在不弹出系统界面的情况下卸载应用。</string>
    <string name="do_intro">Android 不允许普通应用静默卸载其他应用。要让 FuckOff 自动执行黑名单，需要将本应用配置为这台手机的「设备所有者」（Device Owner）。</string>
    <string name="do_warning">设备所有者是企业级管理权限，会授予本应用较强的设备管理能力。请只在自己的手机或你负责管理的设备上使用，并先备份数据。</string>
    <string name="do_step1">开启开发者选项与 USB 调试</string>
    <string name="do_step1_desc">设置 → 关于手机 → 连续点按版本号 7 次；然后在开发者选项中打开 USB 调试。</string>
    <string name="do_step2">用数据线连接电脑并执行 ADB 命令</string>
    <string name="do_step2_desc">电脑需要已安装 adb。手机弹出「允许 USB 调试」时请点允许。</string>
    <string name="do_command_label">ADB 命令</string>
    <string name="do_step3">回到本页检测权限</string>
    <string name="do_step3_desc">如果提示已有账户、工作资料或已配置其他设备所有者，通常需要恢复出厂设置后重新配置。</string>
    <string name="do_refresh_desc">配置不会自动生效，执行命令后请点按下方按钮。</string>
    <string name="do_check">检测权限</string>
    <string name="do_clear_title">取消设备所有者</string>
    <string name="do_clear_desc">取消后会自动卸载功能立即失效，手动模式仍然可用。若应用内取消失败，可通过 ADB 解除。</string>
    <string name="do_clear_action">取消设备所有者权限</string>
    <string name="do_clear_confirm_title">取消设备所有者？</string>
    <string name="do_clear_confirm_msg">取消后，FuckOff 将无法继续静默卸载应用。确定继续？</string>
    <string name="action_confirm_cancel">确定取消</string>
    <string name="do_security_title">这个权限用来做什么</string>
    <string name="do_security_text">仅用于卸载你主动加入黑名单的用户应用。FuckOff 没有网络权限，不会上传应用列表、黑名单或使用记录，也不会卸载系统应用。</string>
    <string name="do_command_failed">命令执行失败，请检查设备是否已连接、是否已有账户。</string>
    <string name="do_footer">配置设备所有者前建议先备份。部分品牌手机的系统可能限制该流程。</string>

    <string name="privacy_title">本机运行，不联网</string>
    <string name="privacy_desc">FuckOff 没有申请网络权限。黑名单、日志与应用列表只保存在本机。</string>

